# Copy this file to .env and adjust values. Never commit .env.
# All values below are LOCAL TEST values for the app under test, not real credentials.

# --- Application under test ---
BASE_URL=http://localhost:3000
APP_PORT=3000

# Session lifetime in seconds, and a test-only endpoint to force-expire a session
SESSION_TTL_SECONDS=1800
ENABLE_TEST_ENDPOINTS=false

# --- PostgreSQL (used by Docker Compose, the app, and DB tests) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=shop_test
DB_USER=shop_user
DB_PASSWORD=change_me_locally

# --- Seeded test users (created by the database seed script) ---
TEST_USER_EMAIL=standard.user@example.test
TEST_USER_PASSWORD=change_me_too
# Admin account (same password as the test user) used for authorization tests
ADMIN_EMAIL=admin@example.test
